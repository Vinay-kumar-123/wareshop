# WARESHOP Frontend Environment Variables
# Copy to .env for local development. Never commit sensitive keys to source control.

# Base REST API URL of the WARERENT Express backend
VITE_API_BASE_URL=http://localhost:8001/api/v1

# In Production (Vercel -> Render):
# VITE_API_BASE_URL=https://wareshop-backend.onrender.com/api/v1

# Optional: Google OAuth 2.0 Web Client ID for "Continue with Google" provider authentication
# Must match GOOGLE_CLIENT_ID configured on the backend
VITE_GOOGLE_CLIENT_ID=

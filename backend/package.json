{
  "name": "wareshop-backend",
  "version": "1.0.0",
  "description": "WARESHOP Commercial Property & Business Discovery Marketplace Backend API",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "bootstrap:admin": "node src/scripts/bootstrapAdmin.js",
    "admin:reset-password": "node src/scripts/resetAdminPassword.js",
    "seed:demo": "node src/scripts/seedDemoProviders.js",
    "seed:categories": "node src/scripts/seedCategories.js",
    "test:phase1": "node test-phase1-security.js",
    "test:mvp": "node test-mvp-complete.js",
    "test": "node test-phase1-security.js && node test-mvp-complete.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

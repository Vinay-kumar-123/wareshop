# ==============================================================================
# WARESHOP Backend Environment Variables
# Copy this file to .env and adjust values for your environment.
# DO NOT commit real secrets or .env file to source control.
# ==============================================================================

# Server Configuration
PORT=8001
NODE_ENV=development
TRUST_PROXY=1

# Database (MongoDB Atlas connection string & explicit database name)
# Local: mongodb://localhost:27017/wareshop_dev
# Production: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/wareshop_dev
MONGODB_DB_NAME=wareshop_dev

# CORS Configuration (allowed frontend origin(s); wildcard '*' is rejected in production)
# Multiple origins can be comma-separated, e.g. http://localhost:5173,https://wareshop.in
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Administrator Credentials (Explicit CLI bootstrap via `npm run bootstrap:admin` or `npm run admin:reset-password`)
# Note: Wrap ADMIN_PASSWORD in double quotes if it contains '#' (e.g. ADMIN_PASSWORD="...")
ADMIN_EMAIL=<admin-email-placeholder>
ADMIN_PASSWORD="<strong-admin-password-min-12-chars>"
ADMIN_AUTO_ROTATE_PASSWORD=false
ADMIN_BOOTSTRAP_ON_START=false
ADMIN_SESSION_TTL_HOURS=12

# Provider Session & OTP Security
# Required in production (minimum 32 characters) for HMAC-SHA256 OTP hashing
OTP_HMAC_SECRET=<random-32-byte-hex-secret>
PROVIDER_SESSION_TTL_HOURS=168

# 2Factor SMS OTP Integration (Required in production)
# Server-side only — never expose in frontend VITE_* variables!
TWOFACTOR_API_KEY=<your-2factor-api-key>
TWOFACTOR_BASE_URL=https://2factor.in/API/V1
TWOFACTOR_OTP_TEMPLATE=

# OTP Abuse & Cost Controls
OTP_TTL_MINUTES=5
OTP_VERIFICATION_TTL_MINUTES=10
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_DAILY_MAX_PER_PHONE=5
OTP_GLOBAL_HOURLY_MAX=200

# Media & Image Storage Configuration
# Options: 'local' (development only) or 'cloudinary' (required in production)
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Cloudinary Storage Configuration (Required when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=<your-cloudinary-cloud-name>
CLOUDINARY_API_KEY=<your-cloudinary-api-key>
CLOUDINARY_API_SECRET=<your-cloudinary-api-secret>
CLOUDINARY_FOLDER=wareshop/providers

# Public Direct Contact Reveal Rate Limiting
CONTACT_REVEAL_WINDOW_MS=900000
CONTACT_REVEAL_MAX_REQUESTS=30

# ==============================================================================
# WARESHOP Backend Environment Variables
# Copy this file to .env and fill in real values for your environment.
# NEVER commit .env or real secrets to source control.
# ==============================================================================

# --- Server Configuration ---
# Required in production: NODE_ENV=production
NODE_ENV=development
# Optional (default: 5000)
PORT=8001
# Optional reverse-proxy hop count or boolean (default: 1 for Render/proxies)
TRUST_PROXY=1

# --- MongoDB Database ---
# Required. Localhost URIs and "test" database names are rejected in production.
MONGODB_URI=mongodb://localhost:27017/wareshop_dev
MONGODB_DB_NAME=wareshop_dev

# --- CORS / Frontend Origin ---
# Required in production (comma-separated origins; wildcard '*' is rejected in production)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# --- Administrator Authentication ---
# Required in production. Provision via: npm run bootstrap:admin
# Wrap ADMIN_PASSWORD in double quotes if it contains '#' (min 12 chars, upper/lower/digit/symbol).
ADMIN_EMAIL=<admin-email-placeholder>
ADMIN_PASSWORD="<strong-admin-password-min-12-chars>"
# Optional (default: false). Set true only when intentionally rotating credentials on bootstrap.
ADMIN_AUTO_ROTATE_PASSWORD=false

# --- Provider OTP Security ---
# Required in production: random 32+ byte hex secret for HMAC-SHA256 OTP hashing.
OTP_HMAC_SECRET=<random-32-byte-hex-secret>

# --- Resend Email OTP ---
# Required for Email OTP delivery (backend-only; never expose in frontend VITE_* vars).
# Docs: https://resend.com/docs
RESEND_API_KEY=<your-resend-api-key>
RESEND_FROM_EMAIL=WARERENT <no-reply@yourdomain.com>
# Optional reply-to address for OTP emails
RESEND_REPLY_TO=

# --- Google OAuth 2.0 (Optional alongside Email OTP) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=
# --- OTP Rate Limits & Abuse Controls (Optional; defaults shown) ---
OTP_TTL_MINUTES=5
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_EMAIL_DAY=5
OTP_MAX_PER_IP_HOUR=20
OTP_MAX_GLOBAL_HOUR=200

# --- Image Storage & Cloudinary ---
# Options: 'local' (development) or 'cloudinary' (recommended for production)
STORAGE_PROVIDER=local
# Optional local storage settings (used when STORAGE_PROVIDER=local)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Conditionally required when STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=<your-cloudinary-cloud-name>
CLOUDINARY_API_KEY=<your-cloudinary-api-key>
CLOUDINARY_API_SECRET=<your-cloudinary-api-secret>
# Optional (default: wareshop/providers)
CLOUDINARY_FOLDER=wareshop/providers

# --- Public Contact Reveal Rate Limiting (Optional; defaults shown) ---
CONTACT_REVEAL_WINDOW_MS=900000
CONTACT_REVEAL_MAX_REQUESTS=30

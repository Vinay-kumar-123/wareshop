# ==============================================================================
# KONNEVIA Backend Environment Variables
# Copy this file to .env and adjust values for your environment.
# DO NOT commit real secrets or .env file to source control.
# ==============================================================================

# Server Configuration
PORT=8001
NODE_ENV=development

# Database (MongoDB Atlas connection string)
# Local: mongodb://localhost:27017/konnevia
# Production: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/konnevia?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/konnevia

# CORS Configuration (allowed frontend origin(s))
# Multiple origins can be comma-separated, e.g. http://localhost:5173,https://konnevia.vercel.app
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Administrator Credentials (Initial SUPER_ADMIN bootstrap)
ADMIN_EMAIL=admin@konnevia.in
ADMIN_PASSWORD=change_this_to_a_strong_password_in_production
JWT_SECRET=generate_a_random_64_byte_hex_string_for_production
ADMIN_AUTO_ROTATE_PASSWORD=false

# Media & Image Storage Configuration
# Options: 'local' (filesystem in uploads directory) or 'cloudinary' (cloud object storage)
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Cloudinary Storage Configuration (when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=konnevia/providers

# 2Factor OTP delivery. Required for production provider verification.
# Create these privately in the 2Factor dashboard; never expose them to the frontend.
TWOFACTOR_API_KEY=
TWOFACTOR_BASE_URL=https://2factor.in/API/V1/OTP/SEND
TWOFACTOR_OTP_TEMPLATE=LOGIN_OTP

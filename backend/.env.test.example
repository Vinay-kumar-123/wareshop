# Copy to .env.test and load these values only in a dedicated test process.
# Never use a production database or production credentials for integration tests.
NODE_ENV=test
PORT=8000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/konnevia_test?retryWrites=true&w=majority
ADMIN_EMAIL=test-admin@example.invalid
ADMIN_PASSWORD=<unique-test-only-password>
JWT_SECRET=<unique-test-only-random-secret>
ADMIN_AUTO_ROTATE_PASSWORD=true
CORS_ORIGIN=http://localhost:5173
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads-test
MAX_FILE_SIZE_MB=5

# Copy to .env.test and load these values only in a dedicated test process.
# Never use a production database or production credentials for integration tests.
NODE_ENV=test
PORT=8000
TRUST_PROXY=1
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/wareshop_test?retryWrites=true&w=majority
MONGODB_DB_NAME=wareshop_test
ADMIN_EMAIL=test-admin@example.invalid
ADMIN_PASSWORD=<unique-test-only-password>
ADMIN_AUTO_ROTATE_PASSWORD=false
CORS_ORIGIN=http://localhost:5173
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads-test
MAX_FILE_SIZE_MB=5
